{
  "name": "combis-app",
  "private": true,
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:mobile": "npm --prefix mobile start",
    "dev:android": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-windows.ps1 android",
    "dev:ventas": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-windows.ps1 ventas",
    "dev:all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-windows.ps1 all",
    "check": "npm --prefix mobile run typecheck && npm --prefix mobile run lint && npm --prefix backend test",
    "build:android:debug": "npm --prefix mobile run android:debug",
    "build:android:install": "npm --prefix mobile run android:install",
    "mobile": "npm --prefix mobile start",
    "mobile:clear": "npm --prefix mobile run start:clear",
    "mobile:android": "npm --prefix mobile run android",
    "backend": "npm --prefix backend run dev",
    "lint:mobile": "npm --prefix mobile run lint"
  }
}
