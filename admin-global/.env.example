# Desarrollo local: Vite envia /api al backend por este puerto.
API_PORT=5000

# Produccion privada: el navegador habla solo con admin.manecomb.com.
# El Worker reenvia /api/platform/* al backend y conserva la assertion de Access.
VITE_API_URL=https://admin.manecomb.com
VITE_PLATFORM_ACCESS_REQUIRED=true
VITE_PLATFORM_API_HOST=admin.manecomb.com
VITE_PLATFORM_ADMIN_HOST=admin.manecomb.com
