{
  "name": "manecomb-admin",
  "main": "./worker.mjs",
  "compatibility_date": "2026-08-06",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "ADMIN_API_ORIGIN": "https://manecomb.onrender.com"
  }
}
