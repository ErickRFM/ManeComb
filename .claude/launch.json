{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ventas",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "ventas"],
      "port": 5173
    },
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start", "--prefix", "backend"],
      "port": 5001,
      "env": { "PORT": "5001" }
    },
    {
      "name": "ventas-verify",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "ventas", "--", "--port", "5199", "--strictPort"],
      "port": 5199,
      "autoPort": false
    }
  ]
}
