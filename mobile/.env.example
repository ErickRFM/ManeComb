# Build operativo de referencia. Para Sandbox cambia las URLs y MANECOMB_APP_ENV.
MANECOMB_APP_ENV=production
MANECOMB_API_URL=https://manecomb.onrender.com/api
MANECOMB_SOCKET_URL=https://manecomb.onrender.com
MANECOMB_API_TIMEOUT_MS=15000
MANECOMB_GOOGLE_MAPS_API_KEY=
MANECOMB_ANDROID_CLEARTEXT=0

# Firebase Android para mensajes y llamadas con la app cerrada.
# Ruta recomendada: coloca el google-services.json real en android/app/ (esta ignorado por Git).
# Alternativa sin archivo: copia del proyecto Firebase los cuatro valores PUBLICOS siguientes.
MANECOMB_FIREBASE_PROJECT_ID=
MANECOMB_FIREBASE_APP_ID=
MANECOMB_FIREBASE_API_KEY=
MANECOMB_FIREBASE_SENDER_ID=
# En release certificado usa 1 para impedir generar una APK sin FCM.
MANECOMB_REQUIRE_FCM=0

# Desarrollo en dispositivo fisico:
# MANECOMB_APP_ENV=development
# MANECOMB_API_URL=http://192.168.1.20:5000/api
# MANECOMB_SOCKET_URL=http://192.168.1.20:5000
# MANECOMB_LAN_HOST=192.168.1.20
# Las URLs HTTP locales solo se aceptan cuando __DEV__ esta activo.
