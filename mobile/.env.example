# Cambia 192.168.X.X por la IPv4 Wi-Fi de tu laptop para probar en celular fisico.
# En emulador Android, la app sustituye automaticamente hosts locales por 10.0.2.2.
MANECOMB_API_URL=http://192.168.X.X:5000/api
MANECOMB_SOCKET_URL=http://192.168.X.X:5000
MANECOMB_LAN_HOST=192.168.X.X
MANECOMB_API_TIMEOUT_MS=15000
MANECOMB_GOOGLE_MAPS_API_KEY=
MANECOMB_ANDROID_CLEARTEXT=1
