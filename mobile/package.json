{
  "name": "CombisControl",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "start": "react-native start --port 8081",
    "start:clear": "react-native start --port 8081 --reset-cache",
    "android": "node ./scripts/android-run.js",
    "android:device": "node ./scripts/android-device.js",
    "android:debug": "cd android && gradlew.bat assembleDebug",
    "android:install": "node ./scripts/android-install-debug.js",
    "android:bundle": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res",
    "android:debug-bundled": "node ./scripts/build-android-debug-bundled.js",
    "android:release-bundled": "npm run android:bundle && cd android && gradlew.bat assembleRelease",
    "android:release": "node ./scripts/build-android-apk.js",
    "ios": "react-native run-ios",
    "build": "npm run build:apk:android",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node ./scripts/run-point-to-point-test.mjs && jest --runInBand src/api/offline-cache.test.ts src/utils/account-routing.test.ts src/utils/location-status.test.ts src/utils/radio-status.test.ts src/utils/realtime-state.test.ts src/utils/operational-schedule.test.ts src/screens/map/services/location-service.test.ts src/screens/radio/reducers/radio-reducer.test.ts src/screens/checklist-screen.test.ts src/navigation/route-registry.test.ts src/navigation/navigation-policy.test.ts src/navigation/navigation-hardening.test.ts src/navigation/deep-linking.test.ts",
    "test:e2e:web": "playwright test",
    "test:e2e:web:headed": "playwright test --headed",
    "test:e2e:mobile": "node ./scripts/run-detox-mobile.js test",
    "build:e2e:mobile": "node ./scripts/run-detox-mobile.js build",
    "build:apk:android": "node ./scripts/build-android-apk.js",
    "build:android:release": "node ./scripts/build-android-apk.js",
    "device:doctor": "node ./scripts/device-doctor.js",
    "device:lan": "node ./scripts/set-lan-ip.js"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.3.16",
    "@rnmapbox/maps": "^10.3.2",
    "axios": "^1.15.0",
    "mapbox-gl": "^2.15.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-config": "^1.6.1",
    "react-native-geolocation-service": "^5.3.1",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-image-picker": "^8.2.1",
    "react-native-keychain": "^10.0.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-vector-icons": "^10.3.0",
    "react-native-video": "^6.19.2",
    "react-native-worklets": "0.5.1",
    "socket.io-client": "^4.8.3",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/runtime": "^7.25.0",
    "@playwright/test": "^1.55.0",
    "@react-native-community/cli": "^20.1.3",
    "@react-native-community/cli-platform-android": "^20.1.3",
    "@react-native-community/cli-platform-ios": "^20.1.3",
    "@react-native/babel-preset": "0.81.5",
    "@react-native/eslint-config": "0.81.5",
    "@react-native/metro-config": "0.81.5",
    "@react-native/typescript-config": "0.81.5",
    "@types/jest": "^29.5.13",
    "@types/mapbox-gl": "^3.4.1",
    "@types/react": "~19.1.0",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "babel-plugin-module-resolver": "^5.0.2",
    "detox": "^20.20.0",
    "eslint": "^8.19.0",
    "eslint-plugin-jest": "^29.15.2",
    "jest": "^29.7.0",
    "prettier": "2.8.8",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20"
  },
  "private": true
}
