FROM node:22-alpine AS deps
WORKDIR /app/ventas
COPY ventas/package*.json ./
RUN npm ci

FROM node:22-alpine AS build
WORKDIR /app/ventas
COPY --from=deps /app/ventas/node_modules ./node_modules
COPY ventas ./
COPY shared /app/shared
ARG VITE_API_URL=/api
ARG VITE_SOCKET_URL=/
ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_SOCKET_URL=${VITE_SOCKET_URL}
RUN npm run build

FROM nginx:1.27-alpine AS runner
COPY --from=build /app/ventas/dist /usr/share/nginx/html
COPY infra/nginx/mobile-web.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
