{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ENV": "development",
        "EXPO_ANDROID_CLEARTEXT": "1"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ENV": "preview",
        "EXPO_ANDROID_CLEARTEXT": "1"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "internal": {
      "distribution": "internal",
      "env": {
        "APP_ENV": "preview",
        "EXPO_ANDROID_CLEARTEXT": "1"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "APP_ENV": "production",
        "EXPO_ANDROID_CLEARTEXT": "0"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "detox": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ENV": "development",
        "EXPO_ANDROID_CLEARTEXT": "1"
      },
      "android": {
        "buildType": "apk"
      }
    }
  }
}
