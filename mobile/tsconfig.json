{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "baseUrl": ".",
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "ventas/*": [
        "../ventas/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../ventas/**/*.ts",
    "../ventas/**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
