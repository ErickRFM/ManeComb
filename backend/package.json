{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend API para app React Native de combis",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon",
    "start": "node src/server.js",
    "test": "node test/proxy.test.js && node test/env.test.js && node test/auth-context.test.js && node test/cors.test.js && node test/telemetry.test.js && node test/navigation-trips.test.js && node test/activation-keys.test.js && node test/tenant-isolation.test.js && node test/app-smoke.test.js",
    "diagnose:auth": "node scripts/diagnose-auth-account.js"
  },
  "keywords": [
    "backend",
    "express",
    "mongodb",
    "react-native",
    "api",
    "socket.io"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.34.2",
    "cloudinary": "^2.9.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.4.1",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "redis": "^4.7.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "engines": {
    "node": ">=18"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "js,json",
    "ignore": [
      "node_modules"
    ],
    "exec": "node src/server.js"
  }
}
