HOST=0.0.0.0
PORT=5000
MONGO_URI=
# Alias aceptado para Render/Atlas si ya lo tienes configurado asi:
# MONGODB_URI=
MONGO_DB_NAME=combisapp
MONGO_SERVER_SELECTION_TIMEOUT_MS=8000
REQUIRE_MONGO=true
# Obligatorio en produccion/Render. Usa al menos 32 caracteres.
JWT_SECRET=
# Secreto independiente para el Admin Global (Plataforma). Si se omite, la
# autenticación Platform queda deshabilitada (fail-closed) sin afectar enterprise.
# Mínimo 32 caracteres. No usar el mismo valor que JWT_SECRET.
PLATFORM_JWT_SECRET=
PLATFORM_ACCESS_TOKEN_TTL=15m
PLATFORM_REFRESH_TOKEN_TTL_DAYS=30
# Clave AES-256-GCM para cifrar secrets MFA (representación Base64 de 32 bytes).
# Si se omite o es inválida, la autenticación MFA queda fail-closed sin afectar
# enterprise ni el arranque general del backend.
# No usar el mismo valor que JWT_SECRET ni PLATFORM_JWT_SECRET.
PLATFORM_MFA_ENCRYPTION_KEY=
PLATFORM_MFA_CHALLENGE_TTL=5m
# Aliases aceptados si ya existen en Render:
# AUTH_SECRET=
# SESSION_SECRET=
# ACCESS_TOKEN_SECRET=
# Fallback temporal: si JWT_SECRET existe pero es corto, o si falta y existe MONGO_URI/MONGODB_URI, el backend deriva un secreto estable para desbloquear el deploy.
ACCESS_TOKEN_TTL=15m
# Alias aceptado:
# JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
CLIENT_ORIGIN=http://localhost:5173,https://manecomb1.pages.dev,https://*.manecomb1.pages.dev,https://manecomb.pages.dev,https://app.tudominio.com
GOOGLE_MAPS_API_KEY=
APP_URL=http://localhost:8081
# En produccion debe apuntar al enlace HTTPS publico que abre Mobile o Ventas.
PASSWORD_RESET_PUBLIC_URL=https://manecomb.com/reset-password
# Alias aceptado:
# CLIENT_URL=http://localhost:8081
PUBLIC_WEBHOOK_BASE_URL=
# Alias opcionales si prefieres pasar el webhook completo:
# MERCADO_PAGO_WEBHOOK_URL=
# MERCADOPAGO_WEBHOOK_URL=
# MP_WEBHOOK_URL=
# WEBHOOK_URL=
DOCUMENT_STORAGE_DRIVER=mongo
COMMERCIAL_BRAND_NAME=ManeComb
COMMERCIAL_LEGAL_NAME=
COMMERCIAL_SUPPORT_EMAIL=
COMMERCIAL_SUPPORT_PHONE=
BANK_TRANSFER_ACCOUNT_NAME=
BANK_TRANSFER_CLABE=
BANK_TRANSFER_BANK_NAME=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
PAYMENT_PROVIDER=mercado_pago
# Ambiente obligatorio para evitar mezclar checkout sandbox/produccion.
# Valores aceptados: sandbox, production. Aliases: test, prod.
MERCADO_PAGO_ENV=sandbox
# Aliases aceptados:
# MERCADOPAGO_ENV=
# MP_ENV=
MERCADO_PAGO_ACCESS_TOKEN=
# Aliases aceptados:
# MERCADOPAGO_ACCESS_TOKEN=
# MP_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
# Aliases aceptados:
# MERCADOPAGO_PUBLIC_KEY=
# MP_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=
# Aliases aceptados:
# MERCADOPAGO_WEBHOOK_SECRET=
# MP_WEBHOOK_SECRET=
# WEBHOOK_SECRET=
# URLs de retorno opcionales. Si se omiten, se derivan de APP_URL.
# MERCADO_PAGO_SUCCESS_URL=
# MERCADOPAGO_SUCCESS_URL=
# MP_SUCCESS_URL=
# SUCCESS_URL=
# MERCADO_PAGO_FAILURE_URL=
# MERCADOPAGO_FAILURE_URL=
# MP_FAILURE_URL=
# FAILURE_URL=
# MERCADO_PAGO_PENDING_URL=
# MERCADOPAGO_PENDING_URL=
# MP_PENDING_URL=
# PENDING_URL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=
EMAIL_ENABLED=true
EMAIL_DRY_RUN=false
EMAIL_FROM=
EMAIL_FROM_NAME=ManeComb
EMAIL_REPLY_TO=
PORTAL_PUBLIC_URL=
APP_PUBLIC_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_SECRET=
TURN_REALM=
TURN_CREDENTIAL_TTL_SECONDS=3600
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
AUDIO_TRANSCRIPTION_PROVIDER=none
AUDIO_TRANSCRIPTION_API_URL=
AUDIO_TRANSCRIPTION_API_KEY=
AUDIO_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
AUDIO_TRANSCRIPTION_LANGUAGE=es
REDIS_URL=
ENABLE_REDIS=false
ENABLE_QUEUES=false
AUTO_ROUTE_LEARNING_ENABLED=false
AUTO_ROUTE_REVIEW_ENABLED=false
AUTO_ROUTE_ALGORITHM_VERSION=v2
AUTO_ROUTE_GEOMETRY_VERSION=corridor-v1
AUTO_ROUTE_MIN_CORRIDOR_OVERLAP=0.75
AUTO_ROUTE_MAX_CORRIDOR_DISTANCE_METERS=80
AUTO_ROUTE_MAX_LENGTH_DIFFERENCE_RATIO=0.30
# En Render, TRUST_PROXY se activa automaticamente si RENDER=true o RENDER_SERVICE_ID esta definido.
RENDER=
TRUST_PROXY=false
