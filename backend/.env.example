# ManeComb Backend — contrato de configuracion
# Copia este archivo como backend/.env para desarrollo. Nunca subas valores reales.

# Runtime HTTP
HOST=0.0.0.0
PORT=5000
LOG_LEVEL=debug
TRUST_PROXY=false
RENDER=

# MongoDB
MONGO_URI=
# Alias admitido en Render/Atlas: MONGODB_URI
MONGO_DB_NAME=combisapp
MONGO_SERVER_SELECTION_TIMEOUT_MS=8000
REQUIRE_MONGO=true

# Autenticacion enterprise
# Obligatorio y minimo 32 caracteres en cualquier arranque.
JWT_SECRET=
# Secreto independiente recomendado para cifrado de chat. Si se omite usa JWT_SECRET.
CHAT_ENCRYPTION_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Alias admitido: JWT_EXPIRES_IN

# Admin Global / Platform — secretos distintos a JWT_SECRET
# En runtime productivo, si se configura cualquiera de los dos secretos,
# ambos deben ser válidos o el backend abortará antes de escuchar tráfico.
PLATFORM_JWT_SECRET=
PLATFORM_ACCESS_TOKEN_TTL=15m
PLATFORM_REFRESH_TOKEN_TTL_DAYS=30
# Base64 canónico de exactamente 32 bytes para AES-256-GCM.
PLATFORM_MFA_ENCRYPTION_KEY=
PLATFORM_MFA_CHALLENGE_TTL=5m

# Clientes y URLs publicas
# En Render incluye todos los orígenes reales. No uses * en Produccion.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,https://manecomb.com,https://www.manecomb.com,https://admin.manecomb.com,https://manecomb1.pages.dev,https://*.manecomb1.pages.dev
APP_URL=http://localhost:5173
PASSWORD_RESET_PUBLIC_URL=http://localhost:5173/reset-password
PORTAL_PUBLIC_URL=http://localhost:5173/portal
APP_PUBLIC_URL=http://localhost:8081
PUBLIC_WEBHOOK_BASE_URL=

# Mapas y rutas
MAPBOX_ACCESS_TOKEN=
MAP_GEOCODING_PROVIDER=mapbox
MAP_ROUTING_PROVIDER=mapbox
PHOTON_API_URL=https://photon.komoot.io
NOMINATIM_API_URL=https://nominatim.openstreetmap.org
OSRM_API_URL=https://router.project-osrm.org
VALHALLA_API_URL=
MAP_HTTP_USER_AGENT=ManeComb/1.0
# Conservado para integraciones moviles/documentacion heredada.
GOOGLE_MAPS_API_KEY=

# Firebase Cloud Messaging HTTP v1
# Opcion A: ruta absoluta al JSON privado de la cuenta de servicio en el host.
GOOGLE_APPLICATION_CREDENTIALS=
# Opcion B: tres variables privadas en Render. FCM_PRIVATE_KEY admite \n escapados.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
# Aliases admitidos: FIREBASE_PROJECT_ID, FIREBASE_CLIENT_EMAIL, FIREBASE_PRIVATE_KEY.
# Nunca expongas estas credenciales en mobile/.env.production ni en el repositorio.

# Documentos
DOCUMENT_STORAGE_DRIVER=mongo
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Identidad comercial
COMMERCIAL_BRAND_NAME=ManeComb
COMMERCIAL_LEGAL_NAME=
COMMERCIAL_SUPPORT_EMAIL=
COMMERCIAL_SUPPORT_PHONE=

# Transferencia bancaria directa
BANK_TRANSFER_ACCOUNT_NAME=
BANK_TRANSFER_CLABE=
BANK_TRANSFER_BANK_NAME=

# Pagos
# Valores: manual, mercado_pago o test. test queda prohibido en Produccion.
PAYMENT_PROVIDER=manual
# Obligatorio solamente al reactivar mercado_pago. Valores: sandbox o production.
MERCADO_PAGO_ENV=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_WEBHOOK_URL=
MERCADO_PAGO_SUCCESS_URL=
MERCADO_PAGO_FAILURE_URL=
MERCADO_PAGO_PENDING_URL=
# Aliases admitidos por compatibilidad: MERCADOPAGO_*, MP_* y las URLs cortas
# SUCCESS_URL, FAILURE_URL, PENDING_URL, WEBHOOK_URL.

# Correo
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=
EMAIL_ENABLED=true
# Mantener true en desarrollo/Sandbox. Produccion debe cambiarlo de forma explicita.
EMAIL_DRY_RUN=true
EMAIL_FROM=
EMAIL_FROM_NAME=ManeComb
EMAIL_REPLY_TO=

# WhatsApp opcional
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# RTC / TURN
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_SECRET=
TURN_REALM=
TURN_CREDENTIAL_TTL_SECONDS=3600

# Observabilidad
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Transcripcion opcional
AUDIO_TRANSCRIPTION_PROVIDER=none
AUDIO_TRANSCRIPTION_API_URL=
AUDIO_TRANSCRIPTION_API_KEY=
AUDIO_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
AUDIO_TRANSCRIPTION_LANGUAGE=es

# Redis, colas y persistencia de comunicaciones
REDIS_URL=
ENABLE_REDIS=false
ENABLE_QUEUES=false
REDIS_PERSISTENCE_ENABLED=false
REDIS_MAXMEMORY_POLICY=unknown

# Aprendizaje/revision automatica de rutas
AUTO_ROUTE_LEARNING_ENABLED=false
AUTO_ROUTE_REVIEW_ENABLED=false
AUTO_ROUTE_ALGORITHM_VERSION=v2
AUTO_ROUTE_GEOMETRY_VERSION=corridor-v1
AUTO_ROUTE_ENDPOINT_GRID_DEGREES=0.002
AUTO_ROUTE_CORRIDOR_GRID_METERS=80
AUTO_ROUTE_CORRIDOR_SAMPLE_POINTS=24
AUTO_ROUTE_MIN_CORRIDOR_OVERLAP=0.75
AUTO_ROUTE_MAX_CORRIDOR_DISTANCE_METERS=80
AUTO_ROUTE_MAX_LENGTH_DIFFERENCE_RATIO=0.30
AUTO_ROUTE_MAX_ACCURACY_METERS=80
AUTO_ROUTE_MAX_GAP_SECONDS=300
AUTO_ROUTE_MAX_SPEED_KMH=140
AUTO_ROUTE_MIN_DISTANCE_METERS=500
AUTO_ROUTE_MIN_DURATION_SECONDS=120
AUTO_ROUTE_MIN_EVIDENCE_COUNT=3
AUTO_ROUTE_MIN_POINT_COUNT=10
AUTO_ROUTE_SIMPLIFY_TOLERANCE_METERS=20
PLATFORM_ACCESS_ENFORCEMENT_ENABLED=false
PLATFORM_ACCESS_ISSUER=
PLATFORM_ACCESS_AUDIENCE=
PLATFORM_ACCESS_JWKS_URL=
