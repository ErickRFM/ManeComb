{
  "name": "manecomb-ventas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run verify:contracts && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify:contracts": "npm run verify:mobile-layout && npm run verify:account-routing && npm run verify:portal-capabilities && npm run verify:session-storage && npm run verify:route-plan-authority",
    "verify:mobile-layout": "node scripts/verify-mobile-sales-layout.cjs",
    "verify:account-routing": "node scripts/verify-account-routing.cjs",
    "verify:portal-capabilities": "node scripts/verify-portal-capability-ui.cjs",
    "verify:session-storage": "node scripts/verify-session-storage.cjs",
    "verify:route-plan-authority": "node scripts/verify-route-plan-authority.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "axios": "^1.15.0",
    "mapbox-gl": "^2.15.0",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "^0.21.2",
    "socket.io-client": "^4.8.3",
    "vite": "^7.2.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/mapbox-gl": "^3.4.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.1.0",
    "@types/react-dom": "~19.1.0",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
