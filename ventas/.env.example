# Todas las variables VITE_* terminan dentro del bundle público del navegador.
# Nunca pongas aquí JWT_SECRET, RESEND_API_KEY, credenciales de MongoDB, FCM,
# Mercado Pago privadas, CLABE privada, TURN_SECRET ni cualquier otra credencial.
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# Token público de Mapbox. Restringe este token por URL/origen en Mapbox para
# manecomb.com y www.manecomb.com; no reutilices un token secreto del backend.
VITE_MAPBOX_ACCESS_TOKEN=

# Produccion Cloudflare Pages / www.manecomb.com:
# VITE_API_URL=https://manecomb.onrender.com/api
# VITE_SOCKET_URL=https://manecomb.onrender.com
